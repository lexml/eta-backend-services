                                            "id": "art3_cpt",
                                            "p": [
                                                {
                                                    "TYPE_NAME": "br_gov_lexml__1.GenInline",
                                                    "content": [
                                                        "Esta Lei entra em vigor na data de sua publicação."
                                                    ]
