                                "key": "{http://www.lexml.gov.br/1.0}Artigo",
                                "string": "{http://www.lexml.gov.br/1.0}Artigo"
                            },
                            "value": {
                                "TYPE_NAME": "br_gov_lexml__1.DispositivoType",
                                "id": "art3",
                                "rotulo": "Art. 3º",
                                "lXcontainersOmissis": [
                                    {
