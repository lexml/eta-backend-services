                            },
                            "value": {
                                "TYPE_NAME": "br_gov_lexml__1.DispositivoType",
                                "id": "art1",
                                "rotulo": "Art. 1º",
                                "lXcontainersOmissis": [
                                    {
                                        "name": {
                                            "namespaceURI": "http://www.lexml.gov.br/1.0",
                                            "localPart": "Caput",
                                            "prefix": "",
                                            "key": "{http://www.lexml.gov.br/1.0}Caput",
