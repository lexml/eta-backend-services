                            {
                                "TYPE_NAME": "br_gov_lexml__1.GenInline",
                                "content": [
                                    "Sala das Sessões, 7 de outubro de 2026."
                                ]
                            }
                        ]
                    },
                    "assinaturaTexto": [
                        {
                            "TYPE_NAME": "br_gov_lexml__1.ParsType",
                            "p": [
                                {
                                    "TYPE_NAME": "br_gov_lexml__1.GenInline",
                                    "content": [
                                        {
                                            "name": {
                                                "namespaceURI": "http://www.lexml.gov.br/1.0",
                                                "localPart": "b",
