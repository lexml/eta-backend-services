:"{http://www.lexml.gov.br/1.0}Caput"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","id":"art1_cpt","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    Esta Lei altera a ",{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"span","prefix":"","key":"{http://www.lexml.gov.br/1.0}span","string":"{http://www.lexml.gov.br/1.0}span"},"value":{"TYPE_NAME":"br_gov_lexml__1.GenInline","href":"urn:lex:br:federal:lei:1996-12-20;9394","content":["Lei nº 9.394, de 20 de dezembro de 1996"]}},", para assegurar aos pais ou responsáveis legais o direito à ciência prévia e à solicitação de atividade pedagógica alternativa quanto a conteúdos, atividades ou projetos relacionados à identidade de gênero no âmbito do ensino fundamental, observado o respeito à dignidade da pessoa humana, à liberdade de consciência, ao pluralismo pedagógico e à proteção integral da criança e do adolescente. \n\n  "]}]}}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Artigo","prefix":"","key":"{http://www.lexml.gov.br/1.0}Artigo","string":"{http://www.lexml.gov.br/1.0}Artigo"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","id":"art2","rotulo":"Art. 2º","lXcontainersOmissis":[{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Caput","prefix":"","key":"{http://www.lexml.gov.br/1.0}Caput","string":"{http://www.lexml.gov.br/1.0}Caput"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","id":"art2_cpt","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    A ",{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"span","prefix":"","key":"{http://www.lexml.gov.br/1.0}span","string":"{http://www.lexml.gov.br/1.0}span"},"value":{"TYPE_NAME":"br_gov_lexml__1.GenInline","href":"urn:lex:br:federal:lei:1996-12-20;9394","content":["Lei nº 9.394, de 20 de dezembro de 1996"]}},", passa a vigorar acrescida do seguinte art. 12-A: \n\n  "]}],"alteracao":{"TYPE_NAME":"br_gov_lexml__1.Alteracao","base":"urn:lex:br:federal:lei:1996-12-20;9394","id":"art2_cpt_alt1","content":[{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Artigo","prefix":"","key":"{http://www.lexml.gov.br/1.0}Artigo","string":"{http://www.lexml.gov.br/1.0}Artigo"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1","id":"art2_cpt_alt1_art12-1","abreAspas":"s","rotulo":"Art. 12-A.","lXcontainersOmissis":[{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Caput","prefix":"","key":"{http://www.lexml.gov.br/1.0}Caput","string":"{http://www.lexml.gov.br/1.0}Caput"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_cpt","id":"art2_cpt_alt1_art12-1_cpt","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    As instituições de ensino públicas e privadas que ofertem educação básica assegurarão aos pais ou responsáveis legais: \n\n  "]}],"lXcontainersOmissis":[{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_cpt_inc1","id":"art2_cpt_alt1_art12-1_cpt_inc1","rotulo":"I –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    ciência prévia acerca da realização de atividades, projetos, palestras, materiais complementares ou ações pedagógicas relacionadas à identidade de gênero no ensino fundamental; \n\n  "]}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_cpt_inc2","id":"art2_cpt_alt1_art12-1_cpt_inc2","rotulo":"II –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    acesso às informações pedagógicas essenciais relativas ao conteúdo, metodologia e finalidade educacional das atividades mencionadas no inciso I; \n\n  "]}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_cpt_inc3","id":"art2_cpt_alt1_art12-1_cpt_inc3","rotulo":"III –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    possibilidade de requerer atividade pedagógica alternativa para estudantes menores de 14 (quatorze) anos ou a adolescentes maiores dessa idade, mediante manifestação conjunta com seus pais ou responsáveis, quando houver incompatibilidade comprovadamente fundamentada em convicções morais, filosóficas, religiosas ou valores familiares constitucionalmente protegidos. \n\n  "]}]}}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Paragrafo","prefix":"","key":"{http://www.lexml.gov.br/1.0}Paragrafo","string":"{http://www.lexml.gov.br/1.0}Paragrafo"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par1","id":"art2_cpt_alt1_art12-1_par1","rotulo":"§ 1º","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    O exercício do direito previsto no inciso III do ",{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"i","prefix":"","key":"{http://www.lexml.gov.br/1.0}i","string":"{http://www.lexml.gov.br/1.0}i"},"value":{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["caput"]}},": \n\n  "]}],"lXcontainersOmissis":[{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par1_inc1","id":"art2_cpt_alt1_art12-1_par1_inc1","rotulo":"I –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    não implicará censura pedagógica; \n\n  "]}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par1_inc2","id":"art2_cpt_alt1_art12-1_par1_inc2","rotulo":"II –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    não impedirá o acesso dos demais estudantes às atividades originalmente propostas; \n\n  "]}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par1_inc3","id":"art2_cpt_alt1_art12-1_par1_inc3","rotulo":"III –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    não poderá resultar em sanção disciplinar, constrangimento, discriminação ou prejuízo acadêmico ao estudante; \n\n  "]}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par1_inc4","id":"art2_cpt_alt1_art12-1_par1_inc4","rotulo":"IV –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    deverá observar os princípios da convivência respeitosa, da dignidade da pessoa humana e da não discriminação. \n\n  "]}]}}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Paragrafo","prefix":"","key":"{http://www.lexml.gov.br/1.0}Paragrafo","string":"{http://www.lexml.gov.br/1.0}Paragrafo"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par2","id":"art2_cpt_alt1_art12-1_par2","rotulo":"§ 2º","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    No caso do inciso III do ",{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"i","prefix":"","key":"{http://www.lexml.gov.br/1.0}i","string":"{http://www.lexml.gov.br/1.0}i"},"value":{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["caput"]}},", a instituição de ensino deverá oferecer atividade alternativa de valor pedagógico equivalente para fins de frequência, participação e avaliação escolar. \n\n  "]}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Paragrafo","prefix":"","key":"{http://www.lexml.gov.br/1.0}Paragrafo","string":"{http://www.lexml.gov.br/1.0}Paragrafo"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par3","id":"art2_cpt_alt1_art12-1_par3","rotulo":"§ 3º","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    O disposto neste artigo observará: \n\n  "]}],"lXcontainersOmissis":[{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par3_inc1","id":"art2_cpt_alt1_art12-1_par3_inc1","rotulo":"I –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    o direito dos pais ou responsáveis de participar da definição das propostas educacionais, nos termos do ",{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"span","prefix":"","key":"{http://www.lexml.gov.br/1.0}span","string":"{http://www.lexml.gov.br/1.0}span"},"value":{"TYPE_NAME":"br_gov_lexml__1.GenInline","href":"urn:lex:br:federal:lei:1990-07-13;8069!art53_par1u","content":["parágrafo único do art. 53 da Lei nº 8.069, de 13 de julho de 1990"]}},"; \n\n  "]}]}},{"name":{"namespaceURI":"http://www.lexml.gov.br/1.0","localPart":"Inciso","prefix":"","key":"{http://www.lexml.gov.br/1.0}Inciso","string":"{http://www.lexml.gov.br/1.0}Inciso"},"value":{"TYPE_NAME":"br_gov_lexml__1.DispositivoType","href":"art12-1_par3_inc2","id":"art2_cpt_alt1_art12-1_par3_inc2","rotulo":"II –","p":[{"TYPE_NAME":"br_gov_lexml__1.GenInline","content":["\n    o respeito aos valores culturais, históricos, sociais e religiosos previstos no ",{"name":{"namespaceURI":"http://ww