<?xml version="1.0" encoding="UTF-8"?>
## Template XSL-FO do documento articulado: página, cabeçalho, metadados XMP, alertas, local e data e assinaturas.
## O conteúdo impresso (parte inicial, articulação e justificação) é gerado pela XSLT documento-articulado-conteudo.xsl
## a partir do documento-articulado.xml e chega pronto em $conteudoFo.
## Contexto (DocumentoArticuladoTemplateProcessor): $titulo e $aplicacao (já escapados para XML), $dataIso (data e
## hora da geração, ISO-8601), $tamanhoFonte (pontos), $conteudoFo (fragmento XSL-FO, inserido sem ser
## reinterpretado pelo Velocity) e, para o cabeçalho, $temCabecalho, $imprimirBrasao, $brasao (JPEG em base64),
## $casaLegislativa (pela autoridade da URN; vazio fora das três casas) e $textoCabecalho (já escapado); para o fecho
## e as assinaturas, $local, $dataPorExtenso (vazia sem data válida), $espacoAntesFecho e $assinaturas (lista de
## pares, cada assinatura um mapa com nome, partidoUF e cargo, vazios quando não impressos; tudo já escapado); para os
## alertas, $possuiRevisoes, $possuiComentarios e $pendencias (lista de textos já escapados, como registrados).
<fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format"
	xmlns:madoc="http://www.lexml.gov.br/madoc/2.0"
	xmlns:sf="http://www.senado.gov.br/requerimento/modelo/metadado"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
	font-family="Gentium Basic">
	<fo:layout-master-set>
		<fo:simple-page-master margin-bottom="2cm"
			margin-left="2.5cm" margin-right="2.1cm" margin-top="2.5cm"
			master-name="firstPage" page-height="29.7cm" page-width="21cm">
			## Cabeçalho só na primeira página (issue #74): region-before de 3cm e corpo a 4cm; sem cabeçalho, corpo a 1cm.
			#if($temCabecalho)
			<fo:region-body margin-top="4cm"/>
			<fo:region-before extent="3cm" region-name="header-principal"/>
			#else
			<fo:region-body margin-top="1cm"/>
			#end
		</fo:simple-page-master>
		<fo:simple-page-master margin-bottom="2cm"
			margin-left="2.5cm" margin-right="2.1cm" margin-top="2.5cm"
			master-name="restPage" page-height="29.7cm" page-width="21cm">
			<fo:region-body/>
		</fo:simple-page-master>
		<fo:page-sequence-master
			master-name="document">
			<fo:repeatable-page-master-alternatives>
				<fo:conditional-page-master-reference
					master-reference="firstPage" page-position="first" />
				<fo:conditional-page-master-reference
					master-reference="restPage" page-position="rest" />
			</fo:repeatable-page-master-alternatives>
		</fo:page-sequence-master>
	</fo:layout-master-set>
	<fo:declarations>
		<x:xmpmeta xmlns:x="adobe:ns:meta/" xmlns:check="http://lexeditweb/check">
			<rdf:RDF
				xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
				<check:hash>00000000000000000000000000000000</check:hash>
				<rdf:Description
					xmlns:dc="http://purl.org/dc/elements/1.1/"
					xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
					xmlns:pdfaExtension="http://www.aiim.org/pdfa/ns/extension/"
					xmlns:pdfaProperty="http://www.aiim.org/pdfa/ns/property#"
					xmlns:pdfaSchema="http://www.aiim.org/pdfa/ns/schema#"
					xmlns:pdfaid="http://www.aiim.org/pdfa/ns/id/"
					xmlns:xmp="http://ns.adobe.com/xap/1.0/" rdf:about="">
					<xmp:CreatorTool>$aplicacao</xmp:CreatorTool>
					<xmp:ModifyDate>$dataIso</xmp:ModifyDate>
					<xmp:CreateDate>$dataIso</xmp:CreateDate>
					<xmp:MetadataDate>$dataIso</xmp:MetadataDate>
					<pdf:Keywords>Proposição</pdf:Keywords>
					<pdf:Producer>$aplicacao</pdf:Producer>
					<pdf:PDFVersion>1.7</pdf:PDFVersion>
					<dc:format>application/pdf</dc:format>
					<dc:title>
						<rdf:Alt>
							<rdf:li xml:lang="x-default">$titulo</rdf:li>
						</rdf:Alt>
					</dc:title>
					<dc:description>
						<rdf:Alt>
							<rdf:li xml:lang="x-default">Proposição legislativa</rdf:li>
						</rdf:Alt>
					</dc:description>
					<dc:language>
						<rdf:Bag>
							<rdf:li>pt-BR</rdf:li>
						</rdf:Bag>
					</dc:language>
					<dc:subject>
						<rdf:Bag>
							<rdf:li>Proposição legislativa</rdf:li>
						</rdf:Bag>
					</dc:subject>
					<pdfaid:part>3</pdfaid:part>
					<pdfaid:conformance>B</pdfaid:conformance>
					<pdfaExtension:schemas>
						<rdf:Bag>
							<rdf:li rdf:parseType="Resource">
								<pdfaSchema:namespaceURI>http://ns.adobe.com/pdf/1.3/
								</pdfaSchema:namespaceURI>
								<pdfaSchema:prefix>pdf</pdfaSchema:prefix>
								<pdfaSchema:schema>Adobe PDF Schema</pdfaSchema:schema>
								<pdfaSchema:property>
									<rdf:Seq>
										<rdf:li rdf:parseType="Resource">
											<pdfaProperty:category>internal</pdfaProperty:category>
											<pdfaProperty:description>A name object indicating whether
												the document has been modified to include trapping
												information</pdfaProperty:description>
											<pdfaProperty:name>Trapped</pdfaProperty:name>
											<pdfaProperty:valueType>Text</pdfaProperty:valueType>
										</rdf:li>
									</rdf:Seq>
								</pdfaSchema:property>
							</rdf:li>
							<rdf:li rdf:parseType="Resource">
								<pdfaSchema:namespaceURI>http://www.aiim.org/pdfa/ns/id/
								</pdfaSchema:namespaceURI>
								<pdfaSchema:prefix>pdfaid</pdfaSchema:prefix>
								<pdfaSchema:schema>PDF/A ID Schema</pdfaSchema:schema>
								<pdfaSchema:property>
									<rdf:Seq>
										<rdf:li rdf:parseType="Resource">
											<pdfaProperty:category>internal</pdfaProperty:category>
											<pdfaProperty:description>Part of PDF/A standard
											</pdfaProperty:description>
											<pdfaProperty:name>part</pdfaProperty:name>
											<pdfaProperty:valueType>Integer</pdfaProperty:valueType>
										</rdf:li>
										<rdf:li rdf:parseType="Resource">
											<pdfaProperty:category>internal</pdfaProperty:category>
											<pdfaProperty:description>Amendment of PDF/A standard</pdfaProperty:description>
											<pdfaProperty:name>amd</pdfaProperty:name>
											<pdfaProperty:valueType>Text</pdfaProperty:valueType>
										</rdf:li>
										<rdf:li rdf:parseType="Resource">
											<pdfaProperty:category>internal</pdfaProperty:category>
											<pdfaProperty:description>Conformance level of PDF/A standard</pdfaProperty:description>
											<pdfaProperty:name>conformance</pdfaProperty:name>
											<pdfaProperty:valueType>Text</pdfaProperty:valueType>
										</rdf:li>
									</rdf:Seq>
								</pdfaSchema:property>
							</rdf:li>
						</rdf:Bag>
					</pdfaExtension:schemas>
				</rdf:Description>
			</rdf:RDF>
		</x:xmpmeta>
	</fo:declarations>
	<fo:page-sequence master-reference="document">
## Brasão, casa legislativa e texto do cabeçalho (issue #74). A casa vem da autoridade da URN e só é impressa com o
## brasão; sem casa, não há bloco vazio.
		#if($temCabecalho)
		<fo:static-content flow-name="header-principal">
			#if($imprimirBrasao)
			<fo:block text-align="center" margin-bottom="2pt">
				<fo:external-graphic src="url('data:image/jpeg;base64,$brasao')"/>
				#if($casaLegislativa != '')
				<fo:block font-size="11pt" font-family="ITC-StoneSansStd" margin-top="3pt">$casaLegislativa</fo:block>
				#end
			</fo:block>
			#end
			#if($textoCabecalho != '')
			<fo:block text-align="center">$textoCabecalho</fo:block>
			#end
		</fo:static-content>
		#end
		## Separador das notas de rodapé da justificação (issue #75): traço de 50% da largura e 0,5pt.
		<fo:static-content flow-name="xsl-footnote-separator">
			<fo:block text-align-last="justify">
				<fo:leader leader-length="50%" rule-thickness="0.5pt" leader-pattern="rule"/>
			</fo:block>
		</fo:static-content>
		<fo:flow flow-name="xsl-region-body" font-size="${tamanhoFonte}pt">
			## Alertas e pendências (issue #79), antes da epígrafe, com os dados do lexedit:Metadado: caixa de marcas de
			## revisão, caixa de comentários e caixa de pendências de preenchimento, em 12pt fixo. As pendências saem como
			## registradas pelo editor, mesmo quando repetem o aviso de revisões ou de comentários.
## Alertas -------------------------------------------------------------------------
			#if($possuiRevisoes)
			<fo:block background-color="yellow" color="red" font-size="12pt" font-weight="bold"
				text-align="center" padding=".1cm" space-after=".3cm">
				Este documento contém marcas de revisão e não deve ser protocolado até que estas sejam removidas.
			</fo:block>
			#end
			#if($possuiComentarios)
			<fo:block background-color="yellow" color="red" font-size="12pt" font-weight="bold"
				text-align="center" padding=".1cm" space-after=".3cm">
				Este documento contém comentários e não deve ser protocolado até que sejam removidos.
			</fo:block>
			#end
## Pendências de Preenchimento -----------------------------------------------------
			#if(!$pendencias.isEmpty())
			<fo:block background-color="yellow" color="red" font-size="12pt" font-weight="bold"
					  text-align="left" padding=".1cm" space-after=".3cm" padding-left=".25cm" padding-right=".25cm">
				Este documento contém pendências de preenchimento e não deve ser protocolado até que estas sejam resolvidas:
				<fo:list-block font-weight="normal"
					provisional-label-separation="1em" provisional-distance-between-starts="1em"
					margin-left=".5cm">
					#foreach ($pendencia in $pendencias)
					<fo:list-item space-before=".3em">
					  <fo:list-item-label end-indent="label-end()">
					    <fo:block>&#8226;</fo:block>
					  </fo:list-item-label>
					  <fo:list-item-body start-indent="body-start()">
					    <fo:block>$pendencia</fo:block>
					  </fo:list-item-body>
					</fo:list-item>
					#end
				</fo:list-block>
			</fo:block>
			#end
			## Parte inicial (epígrafe, ementa e preâmbulo), articulação e justificação, geradas pela XSLT. O fragmento
			## tem sempre um fo:block raiz, que o FOP exige no fluxo.
			$conteudoFo
			## Local e data e assinaturas (issue #76), depois de todo o conteúdo, com os dados do lexedit:Metadado. Só
			## assinaturas de parlamentares; sem linhas em branco para assinatura manual (issue #76) e sem assinatura de
			## comissão. Sem data (vazia, ausente ou inválida), o fecho é só o local seguido de vírgula (issue #81,
			## especificação 03 do lexml-eta). Em anexo de parecer (issue #80), o FechoDocumentoArticulado vem vazio.
			#if($local != "" || !$assinaturas.isEmpty())
			<fo:block-container>
				#if($local != "")
				<fo:block keep-with-next.within-page="always"
					keep-with-previous="10" role="fecho"
					space-after="0pt" space-before="$espacoAntesFecho" text-align="justify"
					text-indent="2.5cm" white-space-collapse="false">#if($dataPorExtenso != "")$local, ${dataPorExtenso}.#{else}$local,#{end}</fo:block>
				#end
				#if(!$assinaturas.isEmpty())
				<fo:block font-weight="bold">
					<fo:table role="Signatários"
						table-layout="fixed" width="100%">
						<fo:table-column
							column-width="proportional-column-width(50)" />
						<fo:table-column
							column-width="proportional-column-width(50)" />
						<fo:table-body>
							## Pares de assinaturas; com número ímpar, a última ocupa as duas colunas
							#foreach($par in $assinaturas)
							<fo:table-row>
								#foreach($assinatura in $par)
								<fo:table-cell #if($par.size() == 1)number-columns-spanned="2" #{end}text-align="center">
									<fo:block margin-top="30pt">$assinatura.nome</fo:block>
									#if($assinatura.partidoUF != "")
									<fo:block keep-with-previous="always">$assinatura.partidoUF</fo:block>
									#end
									#if($assinatura.cargo != "")
									<fo:block keep-with-previous="always">$assinatura.cargo</fo:block>
									#end
								</fo:table-cell>
								#end
							</fo:table-row>
							#end
						</fo:table-body>
					</fo:table>
				</fo:block>
				#end
			</fo:block-container>
			#end
		</fo:flow>
	</fo:page-sequence>
</fo:root>